# Python cache patterns reduce accidental addition of untracked artifacts.
# Imports and explicit compilation can create cache files. Ignore rules do not
# remove tracked files or filter copied/distribution archives; inspect actual
# package contents before sharing.
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local evolution/cache artifacts are not part of the distributable AISP skill.
.evolution_snapshot/
.version_history/
